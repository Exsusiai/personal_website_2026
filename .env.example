# Notion (Phase 2)
# 注：Notion SDK v5 (API 2025-09-03+) 用 data_source_id 而非 database_id。
# 拿法：GET /v1/databases/{database_id} → data_sources[0].id
NOTION_TOKEN=
NOTION_DS_PROJECTS=
NOTION_DS_THINKING=
NOTION_DS_RESUME=
NOTION_DS_USES=
NOTION_DS_TIMELINE=
NOTION_PAGE_ABOUT=
NOTION_PAGE_NOW=
NOTION_PAGE_CONTACT=

# Supabase (Phase 4)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Usage daemons (Phase 4)
# INGEST_SECRET: 32+ char random string; must match in Vercel env + packages/usage-daemons/.env
# Daemons also need their own env file at packages/usage-daemons/.env (not committed).
# See packages/usage-daemons/README.md for the full daemon env var list.
INGEST_SECRET=
ANTHROPIC_ADMIN_API_KEY=
OPENAI_ADMIN_API_KEY=

# Cloudflare R2 (Phase 3/5)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
